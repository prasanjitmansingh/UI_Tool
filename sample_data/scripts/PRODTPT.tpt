DEFINE JOB LOAD_PRODUCT_STG
DESCRIPTION 'Load product master into staging'
(
  DEFINE SCHEMA PRODUCT_SCHEMA (PROD_CD VARCHAR(8), PROD_NM VARCHAR(60), CATEGORY VARCHAR(20));

  DEFINE OPERATOR FILE_READER
  TYPE DATACONNECTOR PRODUCER
  SCHEMA PRODUCT_SCHEMA
  ATTRIBUTES (VARCHAR FileName = 'DD:PRODIN', VARCHAR Format = 'Delimited', VARCHAR OpenMode = 'Read');

  DEFINE OPERATOR LOAD_OP
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES (VARCHAR TargetTable = 'PROD_STG.PRODUCT_STG', VARCHAR LogTable = 'PROD_STG.PRODUCT_LG');

  APPLY ('INSERT INTO PROD_STG.PRODUCT_STG (:PROD_CD, :PROD_NM, :CATEGORY);')
  TO OPERATOR (LOAD_OP[1])
  SELECT * FROM OPERATOR (FILE_READER[1]);
);
