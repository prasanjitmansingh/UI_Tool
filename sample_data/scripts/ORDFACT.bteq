.LOGON tdprod/etl_user,xxxx;
-- build the order fact from staged orders; customers and products enrich the rows
CREATE VOLATILE TABLE vt_orders AS (
  SELECT o.ORDER_ID, o.CUST_ID, o.PROD_CD, o.QTY, o.AMT, o.ORD_DT
  FROM PROD_STG.ORDERS_STG o
  WHERE o.ORD_DT >= CURRENT_DATE - 7
) WITH DATA ON COMMIT PRESERVE ROWS;

DELETE FROM PROD_DW.ORDER_FACT WHERE ORD_DT >= CURRENT_DATE - 7;

INSERT INTO PROD_DW.ORDER_FACT
SELECT v.ORDER_ID, c.CUST_ID, c.REGION_NM, p.PROD_CD, p.CATEGORY, v.QTY, v.AMT, v.ORD_DT
FROM vt_orders v
JOIN PROD_DW.CUSTOMER c ON c.CUST_ID = v.CUST_ID
JOIN PROD_DW.PRODUCT  p ON p.PROD_CD = v.PROD_CD;
.IF ERRORCODE <> 0 THEN .QUIT 8
.LOGOFF
