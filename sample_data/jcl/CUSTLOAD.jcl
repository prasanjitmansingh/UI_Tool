//CUSTLOAD JOB (ACCT),'CUSTOMER LOAD',CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* LOAD CUSTOMER EXTRACT FROM CORE BANKING INTO STAGING, THEN DW
//*--------------------------------------------------------------------
//         SET ENV=PROD
//STEP010  EXEC PGM=FASTLOAD
//STEPLIB  DD DISP=SHR,DSN=TERADATA.UTILITY.LOADLIB
//INFILE   DD DSN=&ENV..MF.CUSTOMER.EXTRACT(0),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
LOGON tdprod/etl_user,xxxx;
DEFINE CUST_ID (CHAR(10)), CUST_NM (CHAR(40)), REGION_CD (CHAR(3)), OPEN_DT (CHAR(10))
  FILE=INFILE;
BEGIN LOADING PROD_STG.CUSTOMER_STG ERRORFILES PROD_STG.CUSTOMER_E1, PROD_STG.CUSTOMER_E2;
INSERT INTO PROD_STG.CUSTOMER_STG VALUES (:CUST_ID, :CUST_NM, :REGION_CD, :OPEN_DT);
END LOADING;
LOGOFF;
/*
//STEP020  EXEC PGM=BTEQ
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
.LOGON tdprod/etl_user,xxxx;
DATABASE PROD_DW;
DELETE FROM PROD_DW.CUSTOMER ALL;
INSERT INTO PROD_DW.CUSTOMER (CUST_ID, CUST_NM, REGION_NM, OPEN_DT)
SELECT s.CUST_ID, s.CUST_NM, r.REGION_NM, CAST(s.OPEN_DT AS DATE FORMAT 'YYYY-MM-DD')
FROM PROD_STG.CUSTOMER_STG s
LEFT JOIN REF.REGION r ON r.REGION_CD = s.REGION_CD;
.IF ERRORCODE <> 0 THEN .QUIT 8
.LOGOFF
.QUIT 0
/*
