//ORDLOAD  JOB (ACCT),'ORDER LOAD',CLASS=A,MSGCLASS=X
//JOBLIB   DD DISP=SHR,DSN=TERADATA.UTILITY.LOADLIB
//*  STAGE DAILY ORDERS WITH MULTILOAD, THEN BUILD THE ORDER FACT
//STAGE    EXEC PGM=MLOAD
//ORDIN    DD DSN=PROD.MF.ORDERS.DAILY,DISP=SHR
//SYSIN    DD DSN=PROD.TD.MLOAD(ORDSTG),DISP=SHR
//*
//FACT     EXEC BTEQRUN,SCRIPT=ORDFACT
//BTEQ.SYSIN DD DSN=PROD.TD.BTEQ(ORDFACT),DISP=SHR
