DEFINE JOB LOAD_PAYMENT_STG
DESCRIPTION 'Load daily card payments into staging'
(
  DEFINE OPERATOR PAY_READER
  TYPE DATACONNECTOR PRODUCER
  SCHEMA *
  ATTRIBUTES (VARCHAR FileName = 'DD:PAYIN', VARCHAR Format = 'Formatted');

  DEFINE OPERATOR PAY_LOAD
  TYPE UPDATE
  SCHEMA *
  ATTRIBUTES (VARCHAR TargetTable = 'PROD_STG.PAYMENT_STG', VARCHAR LogTable = 'PROD_STG.PAYMENT_LG');

  APPLY ('INSERT INTO PROD_STG.PAYMENT_STG VALUES (:PAY_ID, :ACCT_ID, :PAY_DT, :AMOUNT, :CHANNEL_CD);')
  TO OPERATOR (PAY_LOAD[2])
  SELECT * FROM OPERATOR (PAY_READER[2]);
);
