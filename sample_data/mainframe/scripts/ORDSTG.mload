.LOGON tdprod/etl_user,xxxx;
.BEGIN IMPORT MLOAD TABLES PROD_STG.ORDERS_STG
    WORKTABLES PROD_STG.ORDERS_WT
    ERRORTABLES PROD_STG.ORDERS_ET PROD_STG.ORDERS_UV;
.LAYOUT ORDLAYOUT;
.FIELD ORDER_ID * CHAR(12);
.FIELD CUST_ID  * CHAR(10);
.FIELD PROD_CD  * CHAR(8);
.FIELD QTY      * CHAR(6);
.FIELD AMT      * CHAR(12);
.FIELD ORD_DT   * CHAR(10);
.DML LABEL INSORD;
INSERT INTO PROD_STG.ORDERS_STG VALUES (:ORDER_ID, :CUST_ID, :PROD_CD, :QTY, :AMT, :ORD_DT);
.IMPORT INFILE ORDIN LAYOUT ORDLAYOUT APPLY INSORD;
.END MLOAD;
.LOGOFF;
