.LOGON tdprod/risk_user,xxxx;
DELETE FROM PROD_DW.CREDIT_RISK ALL;

INSERT INTO PROD_DW.CREDIT_RISK
SELECT a.ACCT_ID, c.CUST_ID, c.REGION_NM,
       SUM(p.AMOUNT) / NULLIFZERO(a.CREDIT_LIMIT) AS UTILISATION,
       COUNT(f.ORDER_ID) AS ORDERS_90D
FROM PROD_DW.ACCOUNT a
JOIN PROD_DW.CUSTOMER c ON c.CUST_ID = a.CUST_ID
LEFT JOIN PROD_DW.PAYMENT_FACT p ON p.ACCT_ID = a.ACCT_ID
LEFT JOIN PROD_DW.ORDER_FACT f ON f.CUST_ID = a.CUST_ID AND f.ORD_DT >= CURRENT_DATE - 90
GROUP BY 1, 2, 3, a.CREDIT_LIMIT;

REPLACE VIEW PROD_DW.V_HIGH_RISK_ACCOUNTS AS
LOCKING ROW FOR ACCESS
SELECT * FROM PROD_DW.CREDIT_RISK WHERE UTILISATION > 0.9;

.EXPORT DATA FILE=RISKOUT
SELECT ACCT_ID, UTILISATION FROM PROD_DW.CREDIT_RISK WHERE UTILISATION > 0.9;
.EXPORT RESET
.LOGOFF
