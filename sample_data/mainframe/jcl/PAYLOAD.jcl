//PAYLOAD  JOB (ACCT),'PAYMENTS LOAD',CLASS=A,MSGCLASS=X
//*  DAILY CARD PAYMENTS VIA TPT, THEN BUILD THE PAYMENT FACT
//TPT      EXEC PGM=TBUILD,PARM='-f DD:TPTIN'
//PAYIN    DD DSN=PROD.MF.PAYMENTS.DAILY(0),DISP=SHR
//TPTIN    DD DSN=PROD.TD.TPT(PAYTPT),DISP=SHR
//FACT     EXEC PGM=BTEQ
//SYSIN    DD *
.LOGON tdprod/etl_user,xxxx;
DELETE FROM PROD_DW.PAYMENT_FACT WHERE PAY_DT = CURRENT_DATE - 1;
INSERT INTO PROD_DW.PAYMENT_FACT
SELECT p.PAY_ID, a.ACCT_ID, a.CUST_ID, p.PAY_DT, p.AMOUNT, p.CHANNEL_CD
FROM PROD_STG.PAYMENT_STG p
JOIN PROD_DW.ACCOUNT a ON a.ACCT_ID = p.ACCT_ID;
.LOGOFF
/*
