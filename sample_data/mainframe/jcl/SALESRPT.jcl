//SALESRPT JOB (ACCT),'SALES REPORTING',CLASS=A,MSGCLASS=X
//BUILD    EXEC PGM=BTEQ
//SUMOUT   DD DSN=PROD.MF.SALES.SUMMARY(+1),DISP=(NEW,CATLG),UNIT=SYSDA
//SYSIN    DD *
.LOGON tdprod/rpt_user,xxxx;
DELETE FROM PROD_DW.SALES_SUMMARY ALL;
INSERT INTO PROD_DW.SALES_SUMMARY
SELECT f.REGION_NM, f.CATEGORY, f.ORD_DT, SUM(f.AMT), SUM(f.QTY)
FROM PROD_DW.ORDER_FACT f
GROUP BY 1, 2, 3;

REPLACE VIEW PROD_DW.V_SALES_BY_REGION AS
LOCKING ROW FOR ACCESS
SELECT REGION_NM, SUM(AMT) AS AMT FROM PROD_DW.SALES_SUMMARY GROUP BY 1;

.EXPORT DATA FILE=SUMOUT
SELECT * FROM PROD_DW.SALES_SUMMARY;
.EXPORT RESET
.LOGOFF
/*
