//ACCTLOAD JOB (ACCT),'ACCOUNT LOAD',CLASS=A,MSGCLASS=X
//*  CORE BANKING ACCOUNT MASTER -> STAGING -> ACCOUNT DIMENSION
//LOAD     EXEC PGM=FASTLOAD
//ACCTIN   DD DSN=PROD.MF.ACCOUNT.MASTER(0),DISP=SHR
//SYSIN    DD *
LOGON tdprod/etl_user,xxxx;
DEFINE ACCT_ID (CHAR(12)), CUST_ID (CHAR(10)), PRODUCT_CD (CHAR(4)),
       OPEN_DT (CHAR(10)), CREDIT_LIMIT (CHAR(12)), STATUS_CD (CHAR(1))
  FILE=ACCTIN;
BEGIN LOADING PROD_STG.ACCOUNT_STG ERRORFILES PROD_STG.ACCOUNT_E1, PROD_STG.ACCOUNT_E2;
INSERT INTO PROD_STG.ACCOUNT_STG VALUES (:ACCT_ID, :CUST_ID, :PRODUCT_CD, :OPEN_DT, :CREDIT_LIMIT, :STATUS_CD);
END LOADING;
LOGOFF;
/*
//DIM      EXEC PGM=BTEQ
//SYSIN    DD *
.LOGON tdprod/etl_user,xxxx;
MERGE INTO PROD_DW.ACCOUNT AS t
USING (
  SEL a.ACCT_ID, c.CUST_ID, a.PRODUCT_CD, a.CREDIT_LIMIT, a.STATUS_CD
  FROM PROD_STG.ACCOUNT_STG a
  JOIN PROD_DW.CUSTOMER c ON c.CUST_ID = a.CUST_ID
) AS s
ON t.ACCT_ID = s.ACCT_ID
WHEN MATCHED THEN UPDATE SET CREDIT_LIMIT = s.CREDIT_LIMIT, STATUS_CD = s.STATUS_CD
WHEN NOT MATCHED THEN INSERT VALUES (s.ACCT_ID, s.CUST_ID, s.PRODUCT_CD, s.CREDIT_LIMIT, s.STATUS_CD);
.IF ERRORCODE <> 0 THEN .QUIT 8
.LOGOFF
