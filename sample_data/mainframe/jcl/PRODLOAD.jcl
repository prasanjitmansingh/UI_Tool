//PRODLOAD JOB (ACCT),'PRODUCT LOAD',CLASS=A,MSGCLASS=X
//TPTLOAD  EXEC PGM=TBUILD,PARM='-f DD:TPTIN'
//PRODIN   DD DSN=PROD.MF.PRODUCT.MASTER,DISP=SHR
//TPTIN    DD DSN=PROD.TD.TPT(PRODTPT),DISP=SHR
//SYSPRINT DD SYSOUT=*
//MERGE    EXEC PGM=BTEQ
//SYSIN    DD *
.LOGON tdprod/etl_user,xxxx;
MERGE INTO PROD_DW.PRODUCT AS t
USING (SEL PROD_CD, PROD_NM, CATEGORY FROM PROD_STG.PRODUCT_STG) AS s
ON t.PROD_CD = s.PROD_CD
WHEN MATCHED THEN UPDATE SET PROD_NM = s.PROD_NM, CATEGORY = s.CATEGORY
WHEN NOT MATCHED THEN INSERT (PROD_CD, PROD_NM, CATEGORY) VALUES (s.PROD_CD, s.PROD_NM, s.CATEGORY);
.LOGOFF
/*
